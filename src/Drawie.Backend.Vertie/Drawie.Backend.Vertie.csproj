<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Drawie.Backend.Vertie</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Drawie.Numerics\Drawie.Numerics.csproj" />
      <ProjectReference Include="..\Drawie.Rendering\Drawie.Rendering.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="AssimpNetter" Version="6.0.5" />
      <PackageReference Include="Slangc.NET" Version="2026.14.1" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Geometry\" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="Shaders\*.slang">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

</Project>
